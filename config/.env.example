# =====================================================================
# AI Personal Assistant Backend - Configuration Environment File
# =====================================================================

# ---------------------------------------------------------------------
# Primary Model & Provider Configuration
# ---------------------------------------------------------------------
# Default model identifier. You can prefix with provider:
# Examples:
#   google:gemini-3.5-flash-lite
#   google:gemini-2.5-flash
#   openai:gpt-4o
#   anthropic:claude-3-7-sonnet-20250219
#   ollama:llama3.2
#   ollama:gemma4:e2b
DEFAULT_MODEL=google:gemini-3.5-flash-lite
MODEL_PROVIDER=google
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------
# API Keys
# ---------------------------------------------------------------------
# Google Gemini API Key (Required for Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional, for GPT-4o / o3 models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional, for Claude 3.5 / 3.7 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq API Key (Optional, for ultra-fast Llama 3 / Mixtral inference)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key & Model (Optional fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ---------------------------------------------------------------------
# Local Ollama Configuration (100% Offline Inference)
# ---------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------
# Security & System Access
# ---------------------------------------------------------------------
# Password used for authorizing sensitive system operations
SYSTEM_PASSWORD=1234

# ---------------------------------------------------------------------
# Google Workspace & Communication Integrations
# ---------------------------------------------------------------------
GMAIL_CREDENTIALS_PATH=./config/credentials.json

# ---------------------------------------------------------------------
# Browser Automation Settings (Playwright)
# ---------------------------------------------------------------------
BROWSER_TYPE=chromium
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=1000

# Mode A: Attach to existing browser session via CDP debug port
BROWSER_CDP_URL=http://localhost:9222

# Mode B: Auto-launch installed local browser (e.g. Brave / Chrome)
BROWSER_EXECUTABLE_PATH=/usr/bin/brave
BROWSER_USER_DATA_DIR=~/.config/BraveSoftware/Brave-Browser

# ---------------------------------------------------------------------
# GitHub Integration
# ---------------------------------------------------------------------
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username_here

# ---------------------------------------------------------------------
# Music / Media Integrations
# ---------------------------------------------------------------------
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret

# ---------------------------------------------------------------------
# Telegram Bot Ingress Channel
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=your_telegram_chat_id_here

# ---------------------------------------------------------------------
# Web & HTTP Gateway Settings
# ---------------------------------------------------------------------
WEB_PORT=8080
WEB_HOST=127.0.0.1

# ---------------------------------------------------------------------
# Redis & Memory Settings
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
ENABLE_UNIFIED_MEMORY=true

# ---------------------------------------------------------------------
# Storage & Workspace Paths
# ---------------------------------------------------------------------
AGENT_WORKSPACE=workspace
SQLITE_DB_PATH=workspace/data/sessions.db
ARTIFACTS_DIR=workspace/artifacts
