{
  "workspace_dir": "workspace",
  "artifacts_dir": "workspace/artifacts",
  "memory_dir": "workspace/Memory",
  "memory_embedding_provider": "onnx",
  "memory_similarity_threshold": 0.70,
  "memory_embedding_model": "BAAI/bge-small-en-v1.5",
  "database_path": "workspace/data/sessions.db",
  "notes_dir": "workspace/notes",
  "allowed_access_roots": [
    "workspace"
  ],
  "timezone": "UTC",
  "log_level": "INFO",
  "max_turn_iterations": 10,
  "artifact_spillover_threshold_bytes": 102400,
  "enable_mail_watcher": true,
  "models": {
    "provider": "google",
    "default_model": "google:gemini-3.5-flash",
    "active_model": "google:gemini-3.5-flash",
    "fallback_models": [
      "google:gemini-3.2-flash",
      "google:gemini-2.5-flash",
      "google:gemini-2.5-pro",
      "google:gemini-2.5-flash-lite",
      "google:gemini-1.5-flash"
    ],
    "auto_fallback_on_quota": true
  },
  "mail_watcher": {
    "enabled": true,
    "description": "Background proactive Gmail watcher daemon accounts (supports multiple accounts)",
    "accounts": [
      {
        "alias": "primary",
        "email": "user@gmail.com",
        "provider": "google",
        "enabled": true
      }
    ]
  }
}
